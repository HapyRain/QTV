{
  "name": "qtv-windows",
  "version": "1.1.1",
  "description": "QTV for Windows — 原生桌面端私人影视与电视直播聚合影院",
  "main": "main.mjs",
  "author": "HapyRain",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "serve": "node local-api-server.mjs 18689",
    "test": "node --test local-api-server.test.mjs",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.qtv.desktop",
    "productName": "QTV",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "local-api-server.mjs",
      "assets/**/*",
      "www/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QTV"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Windows-Portable-${arch}.${ext}"
    }
  }
}
